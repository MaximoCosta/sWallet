# Supabase Postgres connection string. Use the pooled connection string in Vercel.
DATABASE_URL="postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Supabase Auth (login). REQUIRED: without them the API answers 503 and nobody can log in.
# Supabase dashboard > Project Settings > API (or Data API): Project URL, anon/publishable key, service_role/secret key.
# The service key is secret: only in Vercel, never in the browser or in git.
SUPABASE_URL="https://project-ref.supabase.co"
SUPABASE_ANON_KEY="replace-with-the-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-the-service-role-or-secret-key"

# Optional: emails that assign tasks in "Tareas". They are always admin and cannot be disabled or deleted.
# Defaults to maximonewps@gmail.com. Everyone else only sees and updates the tasks assigned to them.
TASK_MANAGER_USERS="maximonewps@gmail.com"

# NextAuth (the secondary /login + /dashboard app). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="true"

# Optional: extra origins allowed to call /api/v1 cross-origin (comma separated).
# Not needed in production (same origin). In development Live Server (:5500) is allowed by default.
API_CORS_ORIGINS=""

# Legacy Express backend for local experiments (backend/). Not used by the deployed app.
BACKEND_PORT=4000
BACKEND_NODE_ENV=development
BACKEND_CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500"
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
ALLOWED_LOGIN_USERS="FranPernil,MaxiTaxi"
ALLOWED_LOGIN_PASSWORD="replace-with-a-private-password"
