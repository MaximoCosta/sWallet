# Supabase Postgres connection string. Use the pooled connection string in Vercel.
DATABASE_URL="postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres"

# NextAuth / Vercel API secrets. REQUIRED: without AUTH_SECRET and ALLOWED_LOGIN_PASSWORD login is disabled.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="true"

# Optional: extra origins allowed to call /api/v1 cross-origin (comma separated).
# Not needed in production (same origin). In development Live Server (:5500) is allowed by default.
API_CORS_ORIGINS=""

# Legacy Express backend for local experiments.
BACKEND_PORT=4000
BACKEND_NODE_ENV=development
BACKEND_CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500"
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
ALLOWED_LOGIN_USERS="FranPernil,MaxiTaxi"
ALLOWED_LOGIN_PASSWORD="replace-with-a-private-password"
