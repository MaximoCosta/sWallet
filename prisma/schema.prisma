// Only the connection lives here. Tables are created by src/lib/migrations.ts and queried with raw SQL.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Prisma requires at least one model to generate the client. This table already exists
// (src/lib/migrations.ts creates it); Prisma migrations are never run against it.
model AppMigration {
  id        String   @id
  appliedAt DateTime @default(now()) @db.Timestamp(3)

  @@map("AppMigration")
}
